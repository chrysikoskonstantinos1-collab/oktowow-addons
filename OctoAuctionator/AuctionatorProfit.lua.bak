----------------------------------------------------------------------
AUCTIONATOR_HISTORICAL_DB = AUCTIONATOR_HISTORICAL_DB or {}
AUCTIONATOR_SAVED_RECIPES = AUCTIONATOR_SAVED_RECIPES or {}
AUCTIONATOR_IGNORED_RECIPES = AUCTIONATOR_IGNORED_RECIPES or {}
AUCTIONATOR_AUTO_OPEN_ADVISOR = (AUCTIONATOR_AUTO_OPEN_ADVISOR == nil) and true or AUCTIONATOR_AUTO_OPEN_ADVISOR
AUCTIONATOR_WATCHLIST     = AUCTIONATOR_WATCHLIST or {
	"Iron Ore", "Iron Bar", "Heavy Stone", "Heavy Grinding Stone",
	"Solid Stone", "Solid Grinding Stone", "Mithril Ore", "Mithril Bar",
	"Gold Bar", "Truesilver Bar", "Golden Rod", "Truesilver Rod",
	"Silver Rod", "Steel Bar", "Steel Weapon Chain", "Iron Shield Spike",
	"Iron Counterweight", "Lesser Moonstone", "Shadowgem", "Moss Agate"
}

-- Common Trade Vendor Reagent Prices (in copper)
local VENDOR_REAGENTS = {
	["Weak Flux"] = 20,
	["Strong Flux"] = 2000,
	["Heavy Stock"] = 200,
	["Solid Stock"] = 1000,
	["Coal"] = 500,
	["Coarse Thread"] = 10,
	["Fine Thread"] = 100,
	["Silken Thread"] = 500,
	["Heavy Silken Thread"] = 2000,
	["Rune Thread"] = 5000,
	["Gray Dye"] = 25,
	["Bleach"] = 25,
	["Black Dye"] = 100,
	["Red Dye"] = 100,
	["Blue Dye"] = 100,
	["Yellow Dye"] = 100,
	["Green Dye"] = 100,
	["Purple Dye"] = 250,
	["Salt"] = 10,
	["Empty Vial"] = 4,
	["Leaded Vial"] = 30,
	["Crystal Vial"] = 400,
	["Imbued Vial"] = 1600,
	["Soothing Spices"] = 16,
	["Hot Spices"] = 20,
	["Refreshing Spring Water"] = 25,
	["Simple Wood"] = 38,
	["Star Wood"] = 500,
	["Simple Grinder"] = 500,
	["Jeweler's Kit"] = 800,
}

----------------------------------------------------------------------
-- Historical Price Tracking
----------------------------------------------------------------------
function Atr_RecordItemNoListings(itemName)
	if not itemName or itemName == "" then return end
	if not AUCTIONATOR_HISTORICAL_DB then AUCTIONATOR_HISTORICAL_DB = {} end
	local key = string.lower(itemName)
	local entry = AUCTIONATOR_HISTORICAL_DB[key]
	if entry then
		entry.noListings = true
		entry.current = 0
		entry.lastScan = time()
	end
	if gAtr_ScanDB then
		gAtr_ScanDB[itemName] = nil
	end
end

function Atr_RecordHistoricalPrice(itemName, newPrice)
	if not itemName or not newPrice or newPrice <= 0 then return end
	if not AUCTIONATOR_HISTORICAL_DB then AUCTIONATOR_HISTORICAL_DB = {} end

	local key = string.lower(itemName)
	local now = time()
	local entry = AUCTIONATOR_HISTORICAL_DB[key]

	if not entry then
		entry = {
			name = itemName,
			current = newPrice,
			prev = newPrice,
			trend = 0,
			trendPct = 0,
			min = newPrice,
			max = newPrice,
			avg = newPrice,
			seenCount = 1,
			lastScan = now,
			noListings = nil,
			history = { { t = now, p = newPrice } }
		}
		AUCTIONATOR_HISTORICAL_DB[key] = entry
	else
		entry.noListings = nil
		-- Update trend if price changed or at least 30 mins since last recorded
		if entry.current ~= newPrice or (now - (entry.lastScan or 0) >= 1800) then
			entry.prev = entry.current
			entry.current = newPrice
			entry.trend = newPrice - entry.prev
			if entry.prev > 0 then
				entry.trendPct = math.floor(((newPrice - entry.prev) / entry.prev) * 100)
			else
				entry.trendPct = 0
			end
			if newPrice < (entry.min or newPrice) then entry.min = newPrice end
			if newPrice > (entry.max or newPrice) then entry.max = newPrice end
			entry.seenCount = (entry.seenCount or 1) + 1
			entry.avg = math.floor(((entry.avg * (entry.seenCount - 1)) + newPrice) / entry.seenCount)
			entry.lastScan = now

			if not entry.history then entry.history = {} end
			table.insert(entry.history, { t = now, p = newPrice })
			if table.getn(entry.history) > 12 then
				table.remove(entry.history, 1)
			end
		end
	end
end

function Atr_GetHistoricalData(itemName)
	if not itemName or not AUCTIONATOR_HISTORICAL_DB then return nil end
	return AUCTIONATOR_HISTORICAL_DB[string.lower(itemName)]
end

function Atr_MigrateExistingScanDB()
	if not AUCTIONATOR_HISTORICAL_DB then AUCTIONATOR_HISTORICAL_DB = {} end
	local realm = GetRealmName();
	local faction = UnitFactionGroup("player");
	local realmKey = (realm and faction) and (realm .. "_" .. faction);
	local db = gAtr_ScanDB or (realmKey and AUCTIONATOR_PRICE_DATABASE and AUCTIONATOR_PRICE_DATABASE[realmKey]);
	if not db and AUCTIONATOR_PRICE_DATABASE then
		for k, v in pairs(AUCTIONATOR_PRICE_DATABASE) do
			if k ~= "__dbversion" and type(v) == "table" then
				db = v;
				break;
			end
		end
	end
	if not db then return end

	local migrated = 0
	local now = time()
	for itemName, price in pairs(db) do
		if type(price) == "number" and price > 0 then
			local key = string.lower(itemName)
			if not AUCTIONATOR_HISTORICAL_DB[key] then
				AUCTIONATOR_HISTORICAL_DB[key] = {
					name = itemName,
					current = price,
					prev = price,
					trend = 0,
					trendPct = 0,
					min = price,
					max = price,
					avg = price,
					seenCount = 1,
					lastScan = now,
					history = { { t = now, p = price } }
				}
				migrated = migrated + 1
			end
		end
	end
end

----------------------------------------------------------------------
-- Price Lookup Helper
----------------------------------------------------------------------
local HIGH_DEMAND_ITEMS = {
	["Golden Rod"] = true,
	["Truesilver Rod"] = true,
	["Silver Rod"] = true,
	["Arcanite Rod"] = true,
	["Heavy Grinding Stone"] = true,
	["Solid Grinding Stone"] = true,
	["Dense Grinding Stone"] = true,
	["Coarse Grinding Stone"] = true,
	["Rough Grinding Stone"] = true,
	["Solid Sharpening Stone"] = true,
	["Dense Sharpening Stone"] = true,
	["Heavy Sharpening Stone"] = true,
	["Coarse Sharpening Stone"] = true,
	["Rough Sharpening Stone"] = true,
	["Steel Weapon Chain"] = true,
	["Mithril Spurs"] = true,
	["Iron Bar"] = true,
	["Steel Bar"] = true,
	["Mithril Bar"] = true,
	["Truesilver Bar"] = true,
	["Thorium Bar"] = true,
	["Bronze Bar"] = true,
	["Copper Bar"] = true,
	["Silver Bar"] = true,
	["Gold Bar"] = true,
	["Iron Shield Spike"] = true,
	["Mithril Shield Spike"] = true
}

function Atr_GetMaterialCost(itemName)
	if not itemName then return 0 end
	if VENDOR_REAGENTS[itemName] then
		return VENDOR_REAGENTS[itemName]
	end
	-- Live full scan lowest price takes precedence if scan running
	if gFS_lowprices and gFS_lowprices[itemName] and gFS_lowprices[itemName][1] and gFS_lowprices[itemName][1] < 999999999 then
		return gFS_lowprices[itemName][1]
	end
	-- 1. Live scan DB takes highest priority (fresh searches & scans)
	if gAtr_ScanDB and gAtr_ScanDB[itemName] and gAtr_ScanDB[itemName] > 0 then
		return gAtr_ScanDB[itemName]
	end
	-- 2. Historical price tracking database
	local hist = Atr_GetHistoricalData(itemName)
	if hist then
		if hist.noListings then return 0 end
		if hist.current and hist.current > 0 then
			return hist.current
		end
	end
	-- 3. Auctionator pricing fallback
	if Atr_GetAuctionPrice then
		local p = Atr_GetAuctionPrice(itemName)
		if p and p > 0 then return p end
	end
	return 0
end

----------------------------------------------------------------------
-- Profession Recipe Learning & Profit Calculation
----------------------------------------------------------------------
local function ScanOpenTradeSkill()
	if not GetNumTradeSkills or GetNumTradeSkills() == 0 then return end
	local skillHeader = GetTradeSkillLine and GetTradeSkillLine() or "Profession"
	local pName = UnitName("player") or "Player"
	if not AUCTIONATOR_SAVED_RECIPES[pName] then
		AUCTIONATOR_SAVED_RECIPES[pName] = {}
	end

	local learned = 0
	for i = 1, GetNumTradeSkills() do
		local skillName, skillType = GetTradeSkillInfo(i)
		if skillType ~= "header" and skillName then
			local itemLink = GetTradeSkillItemLink(i)
			local minMade, maxMade = GetTradeSkillNumMade(i)
			local avgMade = ((minMade or 1) + (maxMade or 1)) / 2
			local numReagents = GetTradeSkillNumReagents(i)

			local reagents = {}
			for r = 1, numReagents do
				local rName, _, rCount = GetTradeSkillReagentInfo(i, r)
				if rName then
					table.insert(reagents, { name = rName, count = rCount or 1 })
				end
			end

			AUCTIONATOR_SAVED_RECIPES[pName][skillName] = {
				name = skillName,
				profession = skillHeader,
				link = itemLink,
				avgMade = avgMade,
				reagents = reagents
			}
			learned = learned + 1
		end
	end

	if learned > 0 and DEFAULT_CHAT_FRAME then
		DEFAULT_CHAT_FRAME:AddMessage("|cff00ffff[Auctionator Advisor]|r Learned " .. learned .. " recipes for " .. skillHeader .. ".")
	end
end

function Atr_GetNumIgnoredRecipes()
	local pName = UnitName("player") or "Player"
	local ignored = AUCTIONATOR_IGNORED_RECIPES and AUCTIONATOR_IGNORED_RECIPES[pName]
	if not ignored then return 0 end
	local count = 0
	for _ in pairs(ignored) do count = count + 1 end
	return count
end

function Atr_RestoreIgnoredRecipes()
	local pName = UnitName("player") or "Player"
	if AUCTIONATOR_IGNORED_RECIPES then
		AUCTIONATOR_IGNORED_RECIPES[pName] = {}
	end
	if DEFAULT_CHAT_FRAME then
		DEFAULT_CHAT_FRAME:AddMessage("|cff00ff00[Auctionator Advisor]|r Restored all hidden recipes to the profit list.")
	end
	Atr_RefreshProfitUI()
end

function Atr_CalculateRecipeProfits()
	local pName = UnitName("player") or "Player"
	local recipes = AUCTIONATOR_SAVED_RECIPES[pName]
	if not recipes then return {} end

	local ignored = (AUCTIONATOR_IGNORED_RECIPES and AUCTIONATOR_IGNORED_RECIPES[pName]) or {}

	local now = time()
	local results = {}
	for name, rec in pairs(recipes) do
		if not ignored[name] then
		local craftCost = 0
		local hasAllPrices = true

		for _, reg in ipairs(rec.reagents) do
			local cost = Atr_GetMaterialCost(reg.name)
			if cost == 0 then
				hasAllPrices = false
			end
			craftCost = craftCost + (cost * reg.count)
		end

		-- Determine real crafted product name (e.g. Mining "Smelt Steel" crafts "Steel Bar")
		local prodName = rec.name
		if rec.link then
			local _, _, linkItem = string.find(rec.link, "%[(.+)%]")
			if linkItem and linkItem ~= "" then
				prodName = linkItem
			end
		end
		if string.find(rec.name, "^Smelt ") then
			prodName = string.gsub(rec.name, "^Smelt ", "") .. " Bar"
		end

		local primaryOre = nil
		if rec.reagents and rec.reagents[1] then
			primaryOre = rec.reagents[1].name
		end

		local sellPrice = Atr_GetMaterialCost(prodName)
		local hist = Atr_GetHistoricalData(prodName)
		local hasListings = (sellPrice > 0) and (not hist or not hist.noListings)
		local isStale = (not hist) or (not hist.lastScan) or (now - hist.lastScan > 86400)
		local isHighDemand = HIGH_DEMAND_ITEMS[prodName] or HIGH_DEMAND_ITEMS[rec.name] or false

		local netRevenue = 0
		local profit = 0
		local margin = 0

		if hasListings then
			netRevenue = math.floor((sellPrice * (rec.avgMade or 1)) * 0.95) -- 5% AH cut
			profit = netRevenue - craftCost
			if craftCost > 0 then
				margin = math.floor((profit / craftCost) * 100)
			end
		end

		table.insert(results, {
			name = rec.name,
			productName = prodName,
			primaryOre = primaryOre,
			isSmelt = (rec.profession == "Mining" or string.find(rec.name, "^Smelt ") ~= nil),
			profession = rec.profession,
			link = rec.link,
			avgMade = rec.avgMade,
			craftCost = craftCost,
			sellPrice = sellPrice,
			netRevenue = netRevenue,
			profit = profit,
			margin = margin,
			hasAllPrices = hasAllPrices,
			hasListings = hasListings,
			isStale = isStale,
			isHighDemand = isHighDemand,
			reagents = rec.reagents
		})
		end
	end

	-- Sort: active listings first, high demand priority, then highest profit
	table.sort(results, function(a, b)
		if a.hasListings ~= b.hasListings then
			return a.hasListings
		end
		if (a.profit > 0 and b.profit > 0) and (a.isHighDemand ~= b.isHighDemand) then
			return a.isHighDemand
		end
		return (a.profit or 0) > (b.profit or 0)
	end)

	return results
end

----------------------------------------------------------------------
-- Raw Materials vs Crafted Arbitrage Engine
----------------------------------------------------------------------
local ARBITRAGE_CONVERSIONS = {
	-- Smelting (Mining)
	{ rawName = "Copper Ore", rawCount = 1, craftedName = "Copper Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Tin Ore", rawCount = 1, craftedName = "Tin Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Silver Ore", rawCount = 1, craftedName = "Silver Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Iron Ore", rawCount = 1, craftedName = "Iron Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Gold Ore", rawCount = 1, craftedName = "Gold Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Mithril Ore", rawCount = 1, craftedName = "Mithril Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Truesilver Ore", rawCount = 1, craftedName = "Truesilver Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Thorium Ore", rawCount = 1, craftedName = "Thorium Bar", craftedCount = 1, prof = "Mining" },
	{ rawName = "Dark Iron Ore", rawCount = 8, craftedName = "Dark Iron Bar", craftedCount = 1, prof = "Mining" },
	-- Stones -> Grinding Stones (Blacksmithing)
	{ rawName = "Rough Stone", rawCount = 1, craftedName = "Rough Grinding Stone", craftedCount = 1, prof = "Blacksmithing" },
	{ rawName = "Coarse Stone", rawCount = 2, craftedName = "Coarse Grinding Stone", craftedCount = 1, prof = "Blacksmithing" },
	{ rawName = "Heavy Stone", rawCount = 3, craftedName = "Heavy Grinding Stone", craftedCount = 1, prof = "Blacksmithing" },
	{ rawName = "Solid Stone", rawCount = 4, craftedName = "Solid Grinding Stone", craftedCount = 1, prof = "Blacksmithing" },
	{ rawName = "Dense Stone", rawCount = 4, craftedName = "Dense Grinding Stone", craftedCount = 1, prof = "Blacksmithing" },
	-- Rods for Enchanting (High Profit BS Crafts)
	{ rawName = "Silver Bar", rawCount = 1, extraCost = 0, craftedName = "Silver Rod", craftedCount = 1, prof = "Blacksmithing" },
	{ rawName = "Gold Bar", rawCount = 1, extraCost = 40, craftedName = "Golden Rod", craftedCount = 1, prof = "Blacksmithing" },
	{ rawName = "Truesilver Bar", rawCount = 1, extraCost = 200, craftedName = "Truesilver Rod", craftedCount = 1, prof = "Blacksmithing" },
}

function Atr_GetArbitrageAnalysis()
	local analysis = {}
	for _, conv in ipairs(ARBITRAGE_CONVERSIONS) do
		local rawPrice = Atr_GetMaterialCost(conv.rawName)
		local rawTotal = rawPrice * conv.rawCount + (conv.extraCost or 0)
		local craftedPrice = Atr_GetMaterialCost(conv.craftedName)
		local craftedGross = craftedPrice * conv.craftedCount
		local craftedNet = math.floor(craftedGross * 0.95)
		local diff = craftedNet - rawTotal

		local advice = "Need Data"
		if rawPrice > 0 and craftedPrice > 0 then
			if diff > 100 then
				advice = "Craft & Sell"
			elseif diff < -50 then
				advice = "Sell Raw"
			else
				advice = "Equal Value"
			end
		end

		table.insert(analysis, {
			rawName = conv.rawName,
			rawCount = conv.rawCount,
			rawUnit = rawPrice,
			rawTotal = rawTotal,
			craftedName = conv.craftedName,
			craftedCount = conv.craftedCount,
			craftedUnit = craftedPrice,
			craftedGross = craftedGross,
			craftedNet = craftedNet,
			diff = diff,
			advice = advice,
			prof = conv.prof
		})
	end
	return analysis
end

----------------------------------------------------------------------
-- Live AH Scan Deal & Sniping Engine
----------------------------------------------------------------------
gAtr_LiveScanDeals = {}
local gAtr_LiveSeenKeys = {}

function Atr_ClearLiveScanDeals()
	gAtr_LiveScanDeals = {}
	gAtr_LiveSeenKeys = {}
end

function Atr_CheckLiveScanDeal(name, itemPrice, buyoutPrice, count, quality, level)
	if not name or name == "" or not itemPrice or itemPrice <= 0 then return end
	local key = string.lower(name)

	local hist = Atr_GetHistoricalData(name)
	local avgPrice = (hist and hist.avg and hist.avg > 0 and hist.avg) or (hist and hist.prev and hist.prev > 0 and hist.prev) or 0
	local seenCount = (hist and hist.seenCount) or 0

	-- Category determination
	local category = "MATS"
	if quality and quality >= 3 and level and level >= 10 then
		category = "BOE"
	elseif string.find(name, "Recipe") or string.find(name, "Plans") or string.find(name, "Schematic") or string.find(name, "Pattern") or string.find(name, "Formula") or string.find(name, "Manual") or string.find(name, "Book") then
		category = "RECIPES"
	elseif string.find(name, "Bar") or string.find(name, "Ore") or string.find(name, "Stone") or string.find(name, "Rod") or string.find(name, "Spike") or string.find(name, "Shield") or string.find(name, "Sword") or string.find(name, "Axe") or string.find(name, "Mace") or string.find(name, "Dagger") or string.find(name, "Bracers") or string.find(name, "Helm") or string.find(name, "Shoulders") or string.find(name, "Breastplate") or string.find(name, "Boots") or string.find(name, "Belt") or string.find(name, "Gauntlets") or string.find(name, "Leggings") then
		category = "BS"
	end

	-- Instant BoE snipe fallback if no prior history
	local isInstantSnipe = false
	if quality and quality == 4 and itemPrice <= 20000 then
		isInstantSnipe = true
		if avgPrice == 0 then avgPrice = 500000 end
	elseif quality and quality == 3 and itemPrice <= 3000 then
		isInstantSnipe = true
		if avgPrice == 0 then avgPrice = 50000 end
	end

	if avgPrice > 0 and (seenCount >= 1 or isInstantSnipe) and itemPrice < avgPrice then
		local expectedNet = math.floor(avgPrice * 0.95)
		local netProfit = expectedNet - itemPrice
		local discountPct = math.floor(((avgPrice - itemPrice) / avgPrice) * 100)

		if (discountPct >= 15 and netProfit >= 200) or isInstantSnipe then
			local dealType, tag, tagColor, priority
			if discountPct >= 40 and netProfit >= 5000 then
				dealType = "DEEP_SNIPE"
				tag = "[LIVE SNIPE]"
				tagColor = "|cffa335ee" -- Epic purple
				priority = 1
			elseif discountPct >= 25 and netProfit >= 2000 then
				dealType = "GREAT_FLIP"
				tag = "[LIVE GREAT FLIP]"
				tagColor = "|cff0070dd" -- Rare blue
				priority = 2
			else
				dealType = "GOOD_FLIP"
				tag = "[LIVE FLIP]"
				tagColor = "|cff1eff00" -- Uncommon green
				priority = 3
			end

			local dealEntry = {
				name = name,
				category = category,
				dealType = dealType,
				tag = tag,
				tagColor = tagColor,
				priority = priority,
				curPrice = itemPrice,
				avgPrice = avgPrice,
				netProfit = netProfit,
				discountPct = discountPct,
				seenCount = seenCount,
				isLive = true
			}

			if gAtr_LiveSeenKeys[key] then
				local idx = gAtr_LiveSeenKeys[key]
				if gAtr_LiveScanDeals[idx] and itemPrice < gAtr_LiveScanDeals[idx].curPrice then
					gAtr_LiveScanDeals[idx] = dealEntry
				end
			else
				table.insert(gAtr_LiveScanDeals, dealEntry)
				gAtr_LiveSeenKeys[key] = table.getn(gAtr_LiveScanDeals)
			end
		end
	end
end

----------------------------------------------------------------------
-- Sniping & Deals Analysis Engine
----------------------------------------------------------------------
function Atr_GetFlipAnalysis(filterCategory)
	local allDeals = {}
	local counts = { ALL = 0, BS = 0, MATS = 0, BOE = 0, RECIPES = 0, SHORTAGES = 0 }
	local seen = {}

	-- Injects live scan deals from active/paused full scan with highest priority
	if gAtr_LiveScanDeals then
		for _, ld in ipairs(gAtr_LiveScanDeals) do
			if ld.name and ld.name ~= "" then
				local k = string.lower(ld.name)
				if not seen[k] then
					seen[k] = true
					counts.ALL = counts.ALL + 1
					if counts[ld.category] then
						counts[ld.category] = counts[ld.category] + 1
					end
					table.insert(allDeals, ld)
				end
			end
		end
	end

	local function CheckCandidate(itemName, category, listName)
		if not itemName or itemName == "" then return end
		local key = string.lower(itemName)
		if seen[key] then return end
		seen[key] = true

		local hist = Atr_GetHistoricalData(itemName)
		local curPrice = Atr_GetMaterialCost(itemName)
		if curPrice <= 0 and hist and hist.current and hist.current > 0 and (not hist.noListings) then
			curPrice = hist.current
		end

		local avgPrice = (hist and hist.avg and hist.avg > 0 and hist.avg) or (hist and hist.prev and hist.prev > 0 and hist.prev) or 0
		local seenCount = (hist and hist.seenCount) or 0
		local noListings = (hist and hist.noListings) or (curPrice == 0 and seenCount > 0)

		-- Shortage check (0 currently on AH, historically worth >= 50 silver, verified by >= 2 scans)
		if noListings and avgPrice >= 5000 and seenCount >= 2 then
			counts.SHORTAGES = counts.SHORTAGES + 1
			counts.ALL = counts.ALL + 1
			if counts[category] then counts[category] = counts[category] + 1 end

			table.insert(allDeals, {
				name = itemName,
				category = category,
				dealType = "SHORTAGE",
				tag = "[SHORTAGE - SELL]",
				tagColor = "|cffffcc00",
				priority = 4,
				curPrice = 0,
				avgPrice = avgPrice,
				netProfit = avgPrice,
				discountPct = 0,
				seenCount = seenCount
			})
			return
		end

		-- Price discount check (requires >= 2 scans so we don't buy based on one-off troll listings)
		if curPrice > 0 and avgPrice > 0 and curPrice < avgPrice and seenCount >= 2 then
			local expectedNet = math.floor(avgPrice * 0.95)
			local netProfit = expectedNet - curPrice
			local discountPct = math.floor(((avgPrice - curPrice) / avgPrice) * 100)

			-- Deal criteria: >= 10% discount and >= 5 silver net profit
			if discountPct >= 10 and netProfit >= 500 then
				local dealType, tag, tagColor, priority
				if discountPct >= 40 and netProfit >= 5000 then
					dealType = "DEEP_SNIPE"
					tag = "[DEEP SNIPE]"
					tagColor = "|cffa335ee" -- Epic purple
					priority = 1
				elseif discountPct >= 25 and netProfit >= 2000 then
					dealType = "GREAT_FLIP"
					tag = "[GREAT FLIP]"
					tagColor = "|cff0070dd" -- Rare blue
					priority = 2
				else
					dealType = "GOOD_FLIP"
					tag = "[FLIP]"
					tagColor = "|cff1eff00" -- Uncommon green
					priority = 3
				end

				counts.ALL = counts.ALL + 1
				if counts[category] then counts[category] = counts[category] + 1 end

				table.insert(allDeals, {
					name = itemName,
					category = category,
					dealType = dealType,
					tag = tag,
					tagColor = tagColor,
					priority = priority,
					curPrice = curPrice,
					avgPrice = avgPrice,
					netProfit = netProfit,
					discountPct = discountPct,
					seenCount = seenCount
				})
			end
		end
	end

	-- Scan all shopping lists
	if AUCTIONATOR_SHOPPING_LISTS then
		for _, slist in ipairs(AUCTIONATOR_SHOPPING_LISTS) do
			local cat = "BS"
			local lName = slist.name or ""
			if string.find(lName, "BoE Epics") or string.find(lName, "Twink") or string.find(lName, "Rings") or string.find(lName, "Chest") then
				cat = "BOE"
			elseif string.find(lName, "Recipes") or string.find(lName, "Plans") then
				cat = "RECIPES"
			elseif string.find(lName, "Materials") or string.find(lName, "Cloth") or string.find(lName, "Potions") or string.find(lName, "Ores") then
				cat = "MATS"
			elseif string.find(lName, "BS:") then
				cat = "BS"
			end
			if slist.items then
				for _, item in ipairs(slist.items) do
					CheckCandidate(item, cat, lName)
				end
			end
		end
	end

	for _, item in ipairs(AUCTIONATOR_WATCHLIST) do
		CheckCandidate(item, "MATS", "Watchlist")
	end

	for item, _ in pairs(HIGH_DEMAND_ITEMS) do
		CheckCandidate(item, "BS", "HighDemand")
	end

	local pName = UnitName("player") or "Player"
	if AUCTIONATOR_SAVED_RECIPES and AUCTIONATOR_SAVED_RECIPES[pName] then
		for _, rec in pairs(AUCTIONATOR_SAVED_RECIPES[pName]) do
			CheckCandidate(rec.name, "BS", "Recipes")
		end
	end

	-- Sort: priority first (Snipes -> Great Flips -> Flips -> Shortages), then netProfit descending
	table.sort(allDeals, function(a, b)
		if a.priority ~= b.priority then
			return a.priority < b.priority
		end
		return a.netProfit > b.netProfit
	end)

	-- Filter matching deals
	local filtered = {}
	for _, d in ipairs(allDeals) do
		local match = false
		if not filterCategory or filterCategory == "ALL" then
			match = true
		elseif filterCategory == "SHORTAGES" then
			match = (d.dealType == "SHORTAGE")
		elseif d.category == filterCategory then
			match = true
		end
		if match then
			table.insert(filtered, d)
		end
	end

	return filtered, counts
end

----------------------------------------------------------------------
-- Daily Market Movers Engine (Price Surges & Dips)
----------------------------------------------------------------------
function Atr_GetDailyMovers()
	local rising = {}
	local falling = {}
	local seen = {}

	if not AUCTIONATOR_HISTORICAL_DB then return rising, falling end

	local function CheckMover(itemName)
		if not itemName or itemName == "" then return end
		local key = string.lower(itemName)
		if seen[key] then return end
		seen[key] = true

		local entry = AUCTIONATOR_HISTORICAL_DB[key]
		if not entry or (entry.seenCount or 0) < 2 then return end

		local cur = entry.current or 0
		local avg = entry.avg or 0
		local prev = entry.prev or cur

		if cur <= 0 or avg <= 0 or avg < 200 then return end -- ignore < 2 silver

		local diffAvg = cur - avg
		local pctAvg = math.floor((diffAvg / avg) * 100)

		local diffPrev = cur - prev
		local pctPrev = (prev > 0) and math.floor(((cur - prev) / prev) * 100) or 0

		-- Rising criteria: +10% vs avg or +15% vs prev
		if pctAvg >= 10 or pctPrev >= 15 then
			table.insert(rising, {
				name = entry.name or itemName,
				current = cur,
				avg = avg,
				prev = prev,
				diff = diffAvg,
				pct = pctAvg,
				pctPrev = pctPrev,
				seenCount = entry.seenCount,
				lastScan = entry.lastScan
			})
		-- Falling criteria: -10% vs avg or -15% vs prev
		elseif pctAvg <= -10 or pctPrev <= -15 then
			table.insert(falling, {
				name = entry.name or itemName,
				current = cur,
				avg = avg,
				prev = prev,
				diff = diffAvg,
				pct = pctAvg,
				pctPrev = pctPrev,
				seenCount = entry.seenCount,
				lastScan = entry.lastScan
			})
		end
	end

	-- Check shopping lists first
	if AUCTIONATOR_SHOPPING_LISTS then
		for _, slist in ipairs(AUCTIONATOR_SHOPPING_LISTS) do
			if slist.items then
				for _, item in ipairs(slist.items) do
					CheckMover(item)
				end
			end
		end
	end

	-- Check watchlist
	for _, item in ipairs(AUCTIONATOR_WATCHLIST) do
		CheckMover(item)
	end

	-- Check crafts
	for item, _ in pairs(HIGH_DEMAND_ITEMS) do
		CheckMover(item)
	end

	-- If fewer than 20 in either list, expand to all scanned AH items in AUCTIONATOR_HISTORICAL_DB
	if table.getn(rising) < 20 or table.getn(falling) < 20 then
		for k, entry in pairs(AUCTIONATOR_HISTORICAL_DB) do
			if entry.name then
				CheckMover(entry.name)
			end
		end
	end

	table.sort(rising, function(a, b)
		return a.pct > b.pct
	end)

	table.sort(falling, function(a, b)
		return a.pct < b.pct
	end)

	return rising, falling
end

----------------------------------------------------------------------
-- Fast Profession, Materials & Flips AH Scan Engine
----------------------------------------------------------------------
local fastScanQueue = {}
local fastScanTotal = 0
local fastScanIndex = 0
local fastScanRunning = false
local fastScanSentAt = 0
local lastFastScanKeepAlive = 0
local lastFastScanQueryTime = 0
local fastScanDriver = CreateFrame("Frame", "AtrFastScanDriver")

function Atr_IsFastScanRunning()
	return fastScanRunning == true
end

function Atr_StartFastProfessionScan()
	if fastScanRunning then
		if DEFAULT_CHAT_FRAME then DEFAULT_CHAT_FRAME:AddMessage("|cff00ffff[Auctionator Advisor]|r Scan already in progress.") end
		return
	end
	if not AuctionFrame or not AuctionFrame:IsShown() then
		if DEFAULT_CHAT_FRAME then DEFAULT_CHAT_FRAME:AddMessage("|cffff4444[Auctionator Advisor]|r Please open the Auction House first!") end
		return
	end

	-- Build unique item list from Mining & Blacksmithing crafts, reagents, watchlist, and shopping lists
	local unique = {}
	local pName = UnitName("player") or "Player"
	if AUCTIONATOR_SAVED_RECIPES[pName] then
		for _, rec in pairs(AUCTIONATOR_SAVED_RECIPES[pName]) do
			local prof = rec.profession or ""
			if prof == "Blacksmithing" or prof == "Mining" then
				local isHigh = HIGH_DEMAND_ITEMS[rec.name]
				local isQualityGear = rec.link and (string.find(rec.link, "cff1eff00") or string.find(rec.link, "cff0070dd") or string.find(rec.link, "cffa335ee"))
				if isHigh or isQualityGear then
					unique[rec.name] = true
					for _, r in ipairs(rec.reagents) do
						if not VENDOR_REAGENTS[r.name] then
							unique[r.name] = true
						end
					end
				end
			end
		end
	end
	for _, item in ipairs(AUCTIONATOR_WATCHLIST) do
		unique[item] = true
	end
	for _, conv in ipairs(ARBITRAGE_CONVERSIONS) do
		unique[conv.rawName] = true
		unique[conv.craftedName] = true
	end
	if AUCTIONATOR_SHOPPING_LISTS then
		for _, slist in ipairs(AUCTIONATOR_SHOPPING_LISTS) do
			if slist.items then
				for _, item in ipairs(slist.items) do
					if item and item ~= "" then
						unique[item] = true
					end
				end
			end
		end
	end

	fastScanQueue = {}
	for name, _ in pairs(unique) do
		table.insert(fastScanQueue, name)
	end

	fastScanTotal = table.getn(fastScanQueue)
	fastScanIndex = 1
	fastScanRunning = true
	fastScanSentAt = 0
	lastFastScanKeepAlive = GetTime()
	lastFastScanQueryTime = GetTime()

	local btn = getglobal("Atr_PBtnScan")
	if btn then btn:SetText("Stop Fast Scan") end

	if DEFAULT_CHAT_FRAME then
		DEFAULT_CHAT_FRAME:AddMessage(string.format("|cff00ffff[Auctionator Advisor]|r Starting fast scan of %d target items (crafts, materials & shopping lists)...", fastScanTotal))
	end
end

local function ProcessFastScanPage()
	if not fastScanRunning then return end
	local currentItem = fastScanQueue[fastScanIndex]
	if not currentItem then return end

	local numBatch = GetNumAuctionItems("list") or 0
	local lowestBuyout = 0

	for i = 1, numBatch do
		local name, _, count, _, _, _, _, _, buyoutPrice = GetAuctionItemInfo("list", i)
		if name and string.lower(name) == string.lower(currentItem) and buyoutPrice and count and count > 0 then
			local unitPrice = math.floor(buyoutPrice / count)
			if unitPrice > 0 and (lowestBuyout == 0 or unitPrice < lowestBuyout) then
				lowestBuyout = unitPrice
			end
		end
	end

	if lowestBuyout > 0 then
		if gAtr_ScanDB then gAtr_ScanDB[currentItem] = lowestBuyout end
		Atr_RecordHistoricalPrice(currentItem, lowestBuyout)
		local hist = Atr_GetHistoricalData(currentItem)
		if hist then hist.noListings = false end
	else
		-- Zero active listings on AH right now
		if gAtr_ScanDB then gAtr_ScanDB[currentItem] = 0 end
		local hist = Atr_GetHistoricalData(currentItem)
		if hist then
			hist.current = 0
			hist.noListings = true
			hist.lastScan = time()
		end
	end

	fastScanIndex = fastScanIndex + 1
	fastScanSentAt = 0

	local sub = getglobal("Atr_ProfitSubTitle")
	if sub and fastScanRunning and fastScanIndex <= fastScanTotal then
		sub:SetText(string.format("|cff00ffffFast Scanning %d/%d:|r %s", fastScanIndex, fastScanTotal, fastScanQueue[fastScanIndex] or ""))
	end

	if fastScanIndex > fastScanTotal then
		fastScanRunning = false
		local btn = getglobal("Atr_PBtnScan")
		if btn then btn:SetText("Fast AH Scan (1-2m)") end
		if sub then
			sub:SetText("Crafting Profit - Arbitrage - Flips & Snipes - Movers")
		end
		if DEFAULT_CHAT_FRAME then
			DEFAULT_CHAT_FRAME:AddMessage("|cff00ff00[Auctionator Advisor]|r Fast scan complete! All items & shopping lists updated.")
		end
		if Atr_RefreshProfitUI then Atr_RefreshProfitUI() end
		if AUCTIONATOR_FS_AUTOLOGOUT and Atr_StartAutoLogout then
			if DEFAULT_CHAT_FRAME then
				DEFAULT_CHAT_FRAME:AddMessage("|cffffcc00[Auctionator Advisor]|r Auto-Logout enabled: Logging out in 5 seconds to safely save database (move to cancel)...")
			end
			Atr_StartAutoLogout(5)
		end
	end
end

fastScanDriver:SetScript("OnUpdate", function()
	if not fastScanRunning then return end
	if not AuctionFrame or not AuctionFrame:IsShown() then
		fastScanRunning = false
		return
	end

	local now = GetTime()

	-- Periodic Anti-AFK Keepalive during fast scan
	if (now - (lastFastScanKeepAlive or 0) > 15) then
		lastFastScanKeepAlive = now
		if (CancelLogout) then CancelLogout() end
		if (StaticPopup_Hide) then StaticPopup_Hide("CAMP") end
		if (UnitIsAFK and UnitIsAFK("player")) then
			if (SlashCmdList and SlashCmdList["AFK"]) then
				SlashCmdList["AFK"]("")
			elseif (SendChatMessage) then
				SendChatMessage("", "AFK")
			end
		end
	end

	-- Timeout retry after 3.5s
	if fastScanSentAt > 0 and (now - fastScanSentAt > 3.5) then
		fastScanSentAt = 0 -- retry
	end

	-- Safe 350ms throttle between items to prevent server kicks / flood disconnects
	if (now - (lastFastScanQueryTime or 0) < 0.35) then
		return
	end

	if fastScanSentAt == 0 and Atr_CanSendAuctionQuery and Atr_CanSendAuctionQuery() then
		local currentItem = fastScanQueue[fastScanIndex]
		if currentItem then
			fastScanSentAt = now
			lastFastScanQueryTime = now
			Atr_QueryAuctionItems(currentItem, nil, nil, 0, 0, 0, 0, 0, 0)
		else
			fastScanRunning = false
		end
	end
end)

fastScanDriver:RegisterEvent("AUCTION_ITEM_LIST_UPDATE")
fastScanDriver:SetScript("OnEvent", function()
	if event == "AUCTION_ITEM_LIST_UPDATE" and fastScanRunning and fastScanSentAt > 0 then
		ProcessFastScanPage()
	end
end)

----------------------------------------------------------------------
-- Gold Advisor UI Window
----------------------------------------------------------------------
local profitFrame = nil
local currentTab = 1
local selectedRecipeName = nil
local currentProfessionFilter = "ALL"
local currentFlipFilter = "ALL"
local currentMoverFilter = "ALL"
local currentFarmTab = "FARM"
local collapsedProfessions = {}

function Atr_ProfitScroll_OnMouseWheel(delta)
	local bar = getglobal("Atr_ProfitScrollScrollBar")
	if bar and bar:IsShown() then
		local current = bar:GetValue() or 0
		local minVal, maxVal = bar:GetMinMaxValues()
		local step = 42
		if delta > 0 then
			bar:SetValue(math.max(minVal, current - step))
		else
			bar:SetValue(math.min(maxVal, current + step))
		end
	end
end

local function Atr_UpdateScrollState(totalHeight)
	local scrollFrame = getglobal("Atr_ProfitScroll")
	local content = getglobal("Atr_ProfitContent")
	if not scrollFrame or not content then return end

	totalHeight = math.max(330, totalHeight)
	content:SetHeight(totalHeight)
	scrollFrame:UpdateScrollChildRect()

	local scrollBar = getglobal("Atr_ProfitScrollScrollBar")
	local scrollUp = getglobal("Atr_ProfitScrollScrollBarScrollUpButton")
	local scrollDown = getglobal("Atr_ProfitScrollScrollBarScrollDownButton")
	local frameHeight = scrollFrame:GetHeight() or 330
	local maxScroll = math.max(0, totalHeight - frameHeight)

	if scrollBar then
		scrollBar:SetMinMaxValues(0, maxScroll)
		scrollBar:SetValueStep(20)

		local curScroll = scrollBar:GetValue() or 0
		if curScroll > maxScroll then
			scrollBar:SetValue(maxScroll)
			scrollFrame:SetVerticalScroll(maxScroll)
		elseif maxScroll == 0 then
			scrollBar:SetValue(0)
			scrollFrame:SetVerticalScroll(0)
		end

		if maxScroll <= 0 then
			scrollBar:Hide()
			if scrollUp then scrollUp:Hide() end
			if scrollDown then scrollDown:Hide() end
		else
			scrollBar:Show()
			if scrollUp then scrollUp:Show() end
			if scrollDown then scrollDown:Show() end
		end
	end
end

function Atr_CreateProfitFrame()
	if profitFrame then return profitFrame end

	profitFrame = CreateFrame("Frame", "Atr_ProfitFrame", UIParent)
	profitFrame:SetWidth(420)
	profitFrame:SetHeight(480)
	if AuctionFrame and AuctionFrame:IsShown() then
		profitFrame:SetPoint("TOPLEFT", AuctionFrame, "TOPRIGHT", 10, -10)
	else
		profitFrame:SetPoint("CENTER", 0, 0)
	end
	profitFrame:SetMovable(true)
	profitFrame:EnableMouse(true)
	profitFrame:RegisterForDrag("LeftButton")
	profitFrame:SetScript("OnDragStart", function() this:StartMoving() end)
	profitFrame:SetScript("OnDragStop", function() this:StopMovingOrSizing(); this.userMoved = true end)
	profitFrame:SetBackdrop({
		bgFile = "Interface\\DialogFrame\\UI-DialogBox-Background",
		edgeFile = "Interface\\DialogFrame\\UI-DialogBox-Border",
		tile = true, tileSize = 32, edgeSize = 32,
		insets = { left = 8, right = 8, top = 8, bottom = 8 }
	})
	profitFrame:Hide()

	-- Title Bar
	local title = profitFrame:CreateFontString(nil, "OVERLAY", "GameFontHighlightLarge")
	title:SetPoint("TOP", 0, -14)
	title:SetText("Auctionator - Gold & Profit Advisor")

	local subTitle = profitFrame:CreateFontString("Atr_ProfitSubTitle", "OVERLAY", "GameFontNormalSmall")
	subTitle:SetPoint("TOP", 0, -36)
	subTitle:SetText("Crafting Profit - Arbitrage - Flips & Snipes - Movers")

	local function SwitchTab(tabIdx)
		currentTab = tabIdx
		local bar = getglobal("Atr_ProfitScrollScrollBar")
		if bar then bar:SetValue(0) end
		local sf = getglobal("Atr_ProfitScroll")
		if sf then sf:SetVerticalScroll(0) end
		Atr_RefreshProfitUI()
	end

	-- 5 Tabs (74px each)
	local tab1 = CreateFrame("Button", "Atr_PTab1", profitFrame, "UIPanelButtonTemplate")
	tab1:SetWidth(74); tab1:SetHeight(22); tab1:SetPoint("TOPLEFT", 16, -58); tab1:SetText("Crafting")
	tab1:SetScript("OnClick", function() SwitchTab(1) end)

	local tab2 = CreateFrame("Button", "Atr_PTab2", profitFrame, "UIPanelButtonTemplate")
	tab2:SetWidth(74); tab2:SetHeight(22); tab2:SetPoint("LEFT", tab1, "RIGHT", 4, 0); tab2:SetText("Arbitrage")
	tab2:SetScript("OnClick", function() SwitchTab(2) end)

	local tab3 = CreateFrame("Button", "Atr_PTab3", profitFrame, "UIPanelButtonTemplate")
	tab3:SetWidth(74); tab3:SetHeight(22); tab3:SetPoint("LEFT", tab2, "RIGHT", 4, 0); tab3:SetText("Flips")
	tab3:SetScript("OnClick", function() SwitchTab(3) end)

	local tab4 = CreateFrame("Button", "Atr_PTab4", profitFrame, "UIPanelButtonTemplate")
	tab4:SetWidth(74); tab4:SetHeight(22); tab4:SetPoint("LEFT", tab3, "RIGHT", 4, 0); tab4:SetText("Movers")
	tab4:SetScript("OnClick", function() SwitchTab(4) end)

	local tab5 = CreateFrame("Button", "Atr_PTab5", profitFrame, "UIPanelButtonTemplate")
	tab5:SetWidth(74); tab5:SetHeight(22); tab5:SetPoint("LEFT", tab4, "RIGHT", 4, 0); tab5:SetText("Farming")
	tab5:SetScript("OnClick", function() SwitchTab(5) end)

	-- Content Scroll Area
	local scrollFrame = CreateFrame("ScrollFrame", "Atr_ProfitScroll", profitFrame, "UIPanelScrollFrameTemplate")
	scrollFrame:SetWidth(385)
	scrollFrame:SetHeight(330)
	scrollFrame:SetPoint("TOPLEFT", 16, -88)
	scrollFrame:EnableMouseWheel(true)
	scrollFrame:SetScript("OnMouseWheel", function()
		Atr_ProfitScroll_OnMouseWheel(arg1)
	end)

	local content = CreateFrame("Frame", "Atr_ProfitContent", scrollFrame)
	content:SetWidth(375)
	content:SetHeight(800)
	content:EnableMouseWheel(true)
	content:SetScript("OnMouseWheel", function()
		Atr_ProfitScroll_OnMouseWheel(arg1)
	end)
	scrollFrame:SetScrollChild(content)

	local emptyText = content:CreateFontString("Atr_PEmptyText", "OVERLAY", "GameFontHighlight")
	emptyText:SetPoint("TOPLEFT", 10, -10)
	emptyText:SetWidth(350)
	emptyText:SetJustifyH("LEFT")
	emptyText:Hide()

	-- Bottom Checkbox: Auto-Logout when scan completes
	local chkLogout = CreateFrame("CheckButton", "Atr_PAutoLogoutCheck", profitFrame, "UICheckButtonTemplate")
	chkLogout:SetWidth(20); chkLogout:SetHeight(20)
	chkLogout:SetPoint("BOTTOMLEFT", 16, 42)
	local chkLogoutText = chkLogout:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
	chkLogoutText:SetPoint("LEFT", chkLogout, "RIGHT", 4, 0)
	chkLogoutText:SetText("Auto-Logout when scan completes (safely saves database)")
	chkLogout:SetChecked(AUCTIONATOR_FS_AUTOLOGOUT and 1 or 0)
	chkLogout:SetScript("OnClick", function()
		AUCTIONATOR_FS_AUTOLOGOUT = (this:GetChecked() == 1)
		local fullScanChk = getglobal("Atr_FullScanLogoutCheck")
		if fullScanChk then fullScanChk:SetChecked(AUCTIONATOR_FS_AUTOLOGOUT and 1 or 0) end
		if DEFAULT_CHAT_FRAME then
			local s = AUCTIONATOR_FS_AUTOLOGOUT and "|cff00ff00Enabled|r" or "|cffff4444Disabled|r"
			DEFAULT_CHAT_FRAME:AddMessage("|cff00ffff[Auctionator]|r Auto-Logout on scan complete: " .. s)
		end
	end)

	-- Bottom Buttons
	local btnScan = CreateFrame("Button", "Atr_PBtnScan", profitFrame, "UIPanelButtonTemplate")
	btnScan:SetWidth(150); btnScan:SetHeight(24); btnScan:SetPoint("BOTTOMLEFT", 16, 14); btnScan:SetText("Fast AH Scan (1-2m)")
	btnScan:SetScript("OnClick", function()
		if fastScanRunning then
			fastScanRunning = false
			fastScanSentAt = 0
			this:SetText("Fast AH Scan (1-2m)")
			local sub = getglobal("Atr_ProfitSubTitle")
			if sub then sub:SetText("Crafting Profit - Arbitrage - Flips & Snipes - Movers") end
			if DEFAULT_CHAT_FRAME then DEFAULT_CHAT_FRAME:AddMessage("|cff00ffff[Auctionator Advisor]|r Fast scan stopped.") end
		else
			Atr_StartFastProfessionScan()
		end
	end)

	local btnLearn = CreateFrame("Button", nil, profitFrame, "UIPanelButtonTemplate")
	btnLearn:SetWidth(140); btnLearn:SetHeight(24); btnLearn:SetPoint("LEFT", btnScan, "RIGHT", 8, 0); btnLearn:SetText("Learn Open Window")
	btnLearn:SetScript("OnClick", function() ScanOpenTradeSkill(); Atr_RefreshProfitUI(); end)

	local btnClose = CreateFrame("Button", nil, profitFrame, "UIPanelButtonTemplate")
	btnClose:SetWidth(70); btnClose:SetHeight(24); btnClose:SetPoint("BOTTOMRIGHT", -16, 14); btnClose:SetText("Close")
	btnClose:SetScript("OnClick", function() profitFrame:Hide(); end)

	return profitFrame
end

function Atr_SearchItemLive(itemName)
	if not itemName or itemName == "" then return end

	if AuctionFrame and AuctionFrame:IsShown() then
		if Atr_SelectPane then
			Atr_SelectPane(3) -- 3 = BUY_TAB
		end
		if Atr_Search_Box then
			Atr_Search_Box:SetText(itemName)
		end
		if Atr_Search_Onclick then
			Atr_Search_Onclick()
		end
		if DEFAULT_CHAT_FRAME then
			DEFAULT_CHAT_FRAME:AddMessage("|cff00ffff[Auctionator Advisor]|r Searching AH for |cffffffff" .. itemName .. "|r...")
		end
	else
		if DEFAULT_CHAT_FRAME then
			DEFAULT_CHAT_FRAME:AddMessage("|cffffaa00[Auctionator Advisor]|r Please talk to an Auctioneer to open the Auction House to check live prices.")
		end
	end
end

function Atr_EnsureAHProfitButton()
	if not AuctionFrame then return end
	local btn = getglobal("Atr_AH_ProfitButton")
	if not btn then
		btn = CreateFrame("Button", "Atr_AH_ProfitButton", AuctionFrame, "UIPanelButtonTemplate")
		btn:SetWidth(88)
		btn:SetHeight(18)
		btn:SetText("Gold Advisor")
		btn:SetFrameLevel(AuctionFrame:GetFrameLevel() + 5)
		btn:SetScript("OnClick", function()
			Atr_ToggleProfitFrame()
		end)
	end
	btn:ClearAllPoints()
	if AuctionFrameCloseButton then
		btn:SetPoint("RIGHT", AuctionFrameCloseButton, "LEFT", -4, 0)
	else
		btn:SetPoint("TOPRIGHT", AuctionFrame, "TOPRIGHT", -38, -14)
	end
	btn:Show()
end

function Atr_RefreshProfitUI()
	if not profitFrame or not profitFrame:IsShown() then return end
	local content = getglobal("Atr_ProfitContent")
	if not content then return end

	local emptyText = getglobal("Atr_PEmptyText")
	if emptyText then
		emptyText:Hide()
	end

	-- Update active tab button highlights
	local tabNames = { "Crafting", "Arbitrage", "Flips", "Movers", "Farming" }
	for t = 1, 5 do
		local tabBtn = getglobal("Atr_PTab" .. t)
		if tabBtn then
			if t == currentTab then
				tabBtn:SetText("|cff00ff00[" .. tabNames[t] .. "]|r")
			else
				tabBtn:SetText(tabNames[t])
			end
		end
	end

	-- Subtitle update based on current tab or scan status
	local sub = getglobal("Atr_ProfitSubTitle")
	local pChk = getglobal("Atr_PAutoLogoutCheck")
	if pChk then
		pChk:SetChecked(AUCTIONATOR_FS_AUTOLOGOUT and 1 or 0)
	end
	if sub and not fastScanRunning then
		if (gAtr_FullScanState == ATR_FS_STARTED) then
			sub:SetText(string.format("|cff00ffffFull Scan in progress (p.%d/%d)...|r Live updates active", (gFS_page or 0) + 1, gFS_pages or 0))
		elseif (gAtr_FullScanState == ATR_FS_PAUSED) then
			sub:SetText(string.format("|cffffcc00Full Scan Paused (p.%d/%d)|r - Prices preserved", (gFS_page or 0) + 1, gFS_pages or 0))
		elseif currentTab == 1 then
			sub:SetText("Crafting Profit - Known Recipe Margins")
		elseif currentTab == 2 then
			sub:SetText("Material Arbitrage - Raw vs Smelted/Crafted")
		elseif currentTab == 3 then
			sub:SetText("Live Snipes & Flips - Underpriced Items on AH")
		elseif currentTab == 4 then
			sub:SetText("Daily Movers - Price Surges & Market Dips")
		elseif currentTab == 5 then
			sub:SetText("Gold Farming Spots & Custom Watchlist")
		end
	end

	-- Hide all existing pooled lines
	local i = 1
	while true do
		local line = getglobal("Atr_PLine_" .. i)
		if not line then break end
		line:Hide()
		line:SetScript("OnClick", nil)
		line:SetScript("OnEnter", nil)
		line:SetScript("OnLeave", nil)
		i = i + 1
	end

	-- Hide all filter buttons across all tabs
	local f = 1
	while true do
		local b = getglobal("Atr_PProfBtn_" .. f)
		if not b then break end
		b:Hide()
		f = f + 1
	end
	f = 1
	while true do
		local b = getglobal("Atr_PFlipBtn_" .. f)
		if not b then break end
		b:Hide()
		f = f + 1
	end
	f = 1
	while true do
		local b = getglobal("Atr_PMoverBtn_" .. f)
		if not b then break end
		b:Hide()
		f = f + 1
	end
	f = 1
	while true do
		local b = getglobal("Atr_PFarmBtn_" .. f)
		if not b then break end
		b:Hide()
		f = f + 1
	end

	local lineIdx = 1
	local function NextLine(width, height)
		local line = getglobal("Atr_PLine_" .. lineIdx)
		if not line then
			line = CreateFrame("Button", "Atr_PLine_" .. lineIdx, content)
			line.text = line:CreateFontString(nil, "OVERLAY", "GameFontNormal")
			line.text:SetJustifyH("LEFT")
			line.sub = line:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
			line.sub:SetJustifyH("LEFT")
			line:SetHighlightTexture("Interface\\HelpFrame\\HelpFrameButton-Highlight")
		end
		line:SetWidth(width or 360)
		line:SetHeight(height or 40)
		line.text:SetWidth((width or 360) - 8)
		line.sub:SetWidth((width or 360) - 8)
		line.text:ClearAllPoints()
		line.text:SetPoint("TOPLEFT", 6, -3)
		line.sub:ClearAllPoints()
		line.sub:SetPoint("TOPLEFT", 6, -21)
		line.text:SetText("")
		line.sub:SetText("")
		line:ClearAllPoints()
		line:RegisterForClicks("LeftButtonUp")
		line:SetScript("OnClick", nil)
		line:SetScript("OnEnter", nil)
		line:SetScript("OnLeave", nil)
		line:EnableMouseWheel(true)
		line:SetScript("OnMouseWheel", function()
			Atr_ProfitScroll_OnMouseWheel(arg1)
		end)
		lineIdx = lineIdx + 1
		return line
	end

	local yOffset = 0

	if currentTab == 1 then
		-- CRAFTING PROFIT TAB
		local recipes = Atr_CalculateRecipeProfits()
		if table.getn(recipes) == 0 then
			local numHidden = Atr_GetNumIgnoredRecipes()
			if numHidden > 0 then
				if emptyText then
					emptyText:SetText(string.format("|cffffcc00All recorded recipes are hidden!|r\n\n(%d items currently hidden)\n\nClick below to restore all recipes.", numHidden))
					emptyText:Show()
				end
				local restoreLine = NextLine(350, 26)
				restoreLine:SetPoint("TOPLEFT", 0, -80)
				restoreLine:RegisterForClicks("LeftButtonUp")
				restoreLine.text:SetText("  |cff00ffff[Click here to Restore All Hidden Items]|r")
				restoreLine.sub:SetText("")
				restoreLine:SetScript("OnClick", function()
					Atr_RestoreIgnoredRecipes()
				end)
				restoreLine:Show()
			elseif emptyText then
				emptyText:SetText("|cffffcc00No recipes recorded yet!|r\n\n1. Open your Blacksmithing / Trade Skill window.\n2. Click '|cff00ffffLearn Open Window|r' below.\n3. Click '|cff00ff00Fast AH Scan|r' to check current market prices!")
				emptyText:Show()
			end
			Atr_UpdateScrollState(340)
			return
		end

		-- Group recipes by profession
		local profGroups = {}
		local profNames = {}
		for _, rec in ipairs(recipes) do
			local p = rec.profession or "Other"
			if not profGroups[p] then
				profGroups[p] = {}
				table.insert(profNames, p)
			end
			table.insert(profGroups[p], rec)
		end

		table.sort(profNames, function(a, b)
			local order = { ["Blacksmithing"] = 1, ["Mining"] = 2, ["Cooking"] = 3, ["First Aid"] = 4 }
			local oa = order[a] or 99
			local ob = order[b] or 99
			if oa ~= ob then return oa < ob end
			return a < b
		end)

		-- Top Profession Filter Pills Bar
		local allFilters = { "ALL" }
		for _, p in ipairs(profNames) do
			table.insert(allFilters, p)
		end

		local fIdx = 1
		local btnX = 0
		for _, p in ipairs(allFilters) do
			local pBtn = getglobal("Atr_PProfBtn_" .. fIdx)
			if not pBtn then
				pBtn = CreateFrame("Button", "Atr_PProfBtn_" .. fIdx, content, "UIPanelButtonTemplate")
				pBtn:SetHeight(20)
				pBtn:SetFrameLevel(content:GetFrameLevel() + 2)
			end
			local label = (p == "ALL") and "All" or p
			local count = (p == "ALL") and table.getn(recipes) or table.getn(profGroups[p])
			local dispText = string.format("%s (%d)", label, count)
			local btnW = math.max(48, string.len(dispText) * 7 + 12)
			pBtn:SetWidth(btnW)
			pBtn:ClearAllPoints()
			pBtn:SetPoint("TOPLEFT", btnX, yOffset)

			local isSelected = (currentProfessionFilter == p)
			if isSelected then
				pBtn:SetText("|cff00ff00[" .. label .. "]|r")
			else
				pBtn:SetText(label)
			end
			pBtn.profName = p
			pBtn:SetScript("OnClick", function()
				currentProfessionFilter = this.profName
				Atr_RefreshProfitUI()
			end)
			pBtn:Show()
			btnX = btnX + btnW + 4
			fIdx = fIdx + 1
		end

		yOffset = yOffset - 26

		-- Render Profession Sections & Folders
		for _, p in ipairs(profNames) do
			if currentProfessionFilter == "ALL" or currentProfessionFilter == p then
				local pRecipes = profGroups[p]
				local count = table.getn(pRecipes)
				local isCollapsed = (collapsedProfessions[p] ~= false) -- Default to collapsed!

				-- Collapsible Profession Folder Header
				local pHeader = NextLine(350, 24)
				pHeader:SetPoint("TOPLEFT", 0, yOffset)
				pHeader:RegisterForClicks("LeftButtonUp")
				local arrow = isCollapsed and "|cffffcc00[+]|r" or "|cff00ffff[-]|r"
				local hint = isCollapsed and "|cff888888(Click to expand)|r" or "|cff888888(Click to collapse)|r"
				pHeader.text:SetText(string.format("  %s |cffffd100%s|r |cffffffff(%d crafts)|r  %s", arrow, p, count, hint))
				pHeader.sub:SetText("")
				pHeader.profName = p
				pHeader:SetScript("OnClick", function()
					local pName = this.profName
					if collapsedProfessions[pName] == false then
						collapsedProfessions[pName] = true
					else
						collapsedProfessions[pName] = false
					end
					Atr_RefreshProfitUI()
				end)
				pHeader:Show()
				yOffset = yOffset - 26

				-- If folder is expanded, render recipes
				if not isCollapsed then
					for _, rec in ipairs(pRecipes) do
						local line = NextLine(360, 40)
						line:SetPoint("TOPLEFT", 0, yOffset)
						line.recName = rec.name
						line.productName = rec.productName or rec.name
						line.primaryOre = rec.primaryOre
						line.isSmelt = rec.isSmelt
						line:RegisterForClicks("LeftButtonUp", "RightButtonUp")

						line:SetScript("OnEnter", function()
							GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
							if this.isSmelt then
								GameTooltip:SetText(string.format("%s (%s)", this.productName, this.recName), 1, 1, 1)
								GameTooltip:AddLine("|cff00ff00Left-Click:|r Search " .. this.productName .. " (Bar) on AH & view mats", 0.9, 0.9, 0.9)
								if this.primaryOre then
									GameTooltip:AddLine("|cffffaa00Right-Click:|r Search " .. this.primaryOre .. " (Ore/Reagent) on AH", 0.9, 0.9, 0.9)
								end
								GameTooltip:AddLine("|cff888888Shift-Right-Click: Remove recipe from list|r", 0.7, 0.7, 0.7)
							else
								GameTooltip:SetText(this.recName, 1, 1, 1)
								GameTooltip:AddLine("|cff00ff00Left-Click:|r View mats breakdown & live AH search", 0.8, 0.8, 0.8)
								GameTooltip:AddLine("|cffff4444Right-Click:|r Remove this item from profit list", 0.8, 0.8, 0.8)
							end
							GameTooltip:Show()
						end)
						line:SetScript("OnLeave", function()
							GameTooltip:Hide()
						end)

						line:SetScript("OnClick", function()
							local btn = arg1 or "LeftButton"
							local tName = this.recName
							local prodItem = this.productName
							local oreItem = this.primaryOre

							if btn == "RightButton" then
								if IsShiftKeyDown() or (not this.isSmelt) then
									local pName = UnitName("player") or "Player"
									if not AUCTIONATOR_IGNORED_RECIPES[pName] then
										AUCTIONATOR_IGNORED_RECIPES[pName] = {}
									end
									AUCTIONATOR_IGNORED_RECIPES[pName][tName] = true
									if selectedRecipeName == tName then
										selectedRecipeName = nil
									end
									if DEFAULT_CHAT_FRAME then
										DEFAULT_CHAT_FRAME:AddMessage(string.format("|cffffaa00[Auctionator Advisor]|r Removed '|cffffffff%s|r' from profit list. (Click 'Restore' or type /profit restore to undo)", tName))
									end
									GameTooltip:Hide()
									Atr_RefreshProfitUI()
									return
								elseif oreItem then
									-- Right-click on Smelt: search Ore / primary reagent!
									Atr_SearchItemLive(oreItem)
									return
								end
							end

							-- Left-Click: Toggle recipe mats breakdown & search Bar / crafted product!
							if selectedRecipeName == tName then
								selectedRecipeName = nil
							else
								selectedRecipeName = tName
							end
							Atr_SearchItemLive(prodItem)
							Atr_RefreshProfitUI()
						end)

						local costStr = zc.priceToMoneyString(rec.craftCost)
						local isExpanded = (selectedRecipeName == rec.name)
						local expandTag = isExpanded and "|cff00ffff[-] |r" or "|cffffcc00[+] |r"

						local displayName = rec.name
						if rec.isSmelt and rec.productName then
							displayName = string.format("%s (|cff888888%s|r)", rec.productName, rec.name)
						end

						if not rec.hasListings then
							line.text:SetText(string.format("  %s|cffaaaaaa%s|r", expandTag, displayName))
							local subHint = rec.isSmelt and "|cff888888[L: Bar | R: Ore]|r" or "|cff888888(Click to search AH)|r"
							line.sub:SetText(string.format("   Cost: %s  |  |cffffaa00[No Current AH Listings]|r  %s", costStr, subHint))
						else
							local profColor = (rec.profit > 0) and "|cff00ff00" or ((rec.profit < 0) and "|cffff4444" or "|cffaaaaaa")
							local profSign = (rec.profit > 0) and "+" or ""
							local profitStr = profColor .. profSign .. zc.priceToMoneyString(rec.profit) .. "|r"
							local marginStr = string.format(" %s(%s%d%%)|r", profColor, profSign, rec.margin)
							local demandTag = rec.isHighDemand and "|cff00ffff[High Demand] |r" or ""
							local staleTag = rec.isStale and " |cffff8800(Old Scan)|r" or ""
							local sellStr = zc.priceToMoneyString(rec.sellPrice)

							line.text:SetText(string.format("  %s%s|cffffffff%s|r%s", expandTag, demandTag, displayName, staleTag))
							line.sub:SetText(string.format("   Cost: %s  |  AH: %s  |  Net: %s%s", costStr, sellStr, profitStr, marginStr))
						end

						line:Show()
						yOffset = yOffset - 42

						-- IF EXPANDED: Show Crafting Reagents Subsection!
						if isExpanded then
							local hdr = NextLine(360, 20)
							hdr:SetPoint("TOPLEFT", 0, yOffset)
							hdr.text:SetText(string.format("     |cffffcc00[Crafting Materials Breakdown for %s]|r", rec.name))
							hdr.sub:SetText("")
							hdr:SetScript("OnClick", nil)
							hdr:Show()
							yOffset = yOffset - 22

							if rec.reagents and table.getn(rec.reagents) > 0 then
								for _, reg in ipairs(rec.reagents) do
									local rLine = NextLine(350, 32)
									rLine:SetPoint("TOPLEFT", 16, yOffset)
									rLine.searchTarget = reg.name
									rLine:RegisterForClicks("LeftButtonUp")
									rLine:SetScript("OnClick", function()
										Atr_SearchItemLive(this.searchTarget)
									end)

									local unitCost = Atr_GetMaterialCost(reg.name)
									local totalCost = unitCost * (reg.count or 1)
									local unitStr = (unitCost > 0) and zc.priceToMoneyString(unitCost) .. " ea" or "|cffff4444No AH Price|r"
									local totalStr = (totalCost > 0) and "  (= " .. zc.priceToMoneyString(totalCost) .. ")" or ""
									local srcTag = VENDOR_REAGENTS[reg.name] and "|cff00ff00[Vendor]|r" or "|cff00ffff[AH Price]|r"

									rLine.text:SetText(string.format("     |cffffd100- %s|r  |cffffffffx%d|r:  %s%s", reg.name, reg.count or 1, unitStr, totalStr))
									rLine.sub:SetText(string.format("        %s  |cff888888(Click to search this material on AH)|r", srcTag))
									rLine:Show()
									yOffset = yOffset - 34
								end
							else
								local noReg = NextLine(350, 20)
								noReg:SetPoint("TOPLEFT", 16, yOffset)
								noReg.text:SetText("     |cff888888(No reagent info cached. Open profession window & click 'Learn Open Window')|r")
								noReg.sub:SetText("")
								noReg:SetScript("OnClick", nil)
								noReg:Show()
								yOffset = yOffset - 22
							end

							local ftr = NextLine(360, 20)
							ftr:SetPoint("TOPLEFT", 0, yOffset)
							local profColor = (rec.profit > 0) and "|cff00ff00+" or "|cffff4444"
							local profitStr = profColor .. zc.priceToMoneyString(math.abs(rec.profit)) .. "|r"
							ftr.text:SetText(string.format("     |cffaaaaaaTotal Mats:|r %s  |  |cffaaaaaaAH Sell:|r %s  |  %s", costStr, zc.priceToMoneyString(rec.sellPrice), profitStr))
							ftr.sub:SetText("")
							ftr:SetScript("OnClick", nil)
							ftr:Show()
							yOffset = yOffset - 26
						end
					end
				end

				yOffset = yOffset - 6
			end
		end

		local numHidden = Atr_GetNumIgnoredRecipes()
		if numHidden > 0 then
			local restoreLine = NextLine(350, 24)
			restoreLine:SetPoint("TOPLEFT", 0, yOffset)
			restoreLine:RegisterForClicks("LeftButtonUp")
			restoreLine.text:SetText(string.format("  |cff888888[%d items hidden]|r  |cff00ffff(Click to restore all hidden items)|r", numHidden))
			restoreLine.sub:SetText("")
			restoreLine:SetScript("OnClick", function()
				Atr_RestoreIgnoredRecipes()
			end)
			restoreLine:Show()
			yOffset = yOffset - 28
		end

	elseif currentTab == 2 then
		-- ARBITRAGE (RAW VS CRAFTED) TAB
		local arbs = Atr_GetArbitrageAnalysis()
		for _, a in ipairs(arbs) do
			local line = NextLine(360, 42)
			line:SetPoint("TOPLEFT", 0, yOffset)
			line.rawTarget = a.rawName
			line.craftedTarget = a.craftedName
			line:RegisterForClicks("LeftButtonUp", "RightButtonUp")
			line:SetScript("OnClick", function()
				local btn = arg1 or "LeftButton"
				if btn == "RightButton" then
					Atr_SearchItemLive(this.rawTarget)
				else
					Atr_SearchItemLive(this.craftedTarget)
				end
			end)

			line:SetScript("OnEnter", function()
				GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
				GameTooltip:SetText(string.format("%s vs %s", this.rawTarget, this.craftedTarget), 1, 1, 1)
				GameTooltip:AddLine("|cff00ff00Left-Click:|r Search " .. this.craftedTarget .. " (Bar/Crafted) on AH", 0.9, 0.9, 0.9)
				GameTooltip:AddLine("|cffffaa00Right-Click:|r Search " .. this.rawTarget .. " (Ore/Raw) on AH", 0.9, 0.9, 0.9)
				GameTooltip:Show()
			end)
			line:SetScript("OnLeave", function()
				GameTooltip:Hide()
			end)

			local advColor = (a.advice == "Craft & Sell") and "|cff00ff00" or ((a.advice == "Sell Raw") and "|cffffaa00" or "|cffaaaaaa")
			line.text:SetText(string.format("%s[%s]|r  %s (%d) -> %s (%d)", advColor, a.advice, a.rawName, a.rawCount, a.craftedName, a.craftedCount))

			local diffStr = (a.diff > 0 and "+") or ""
			diffStr = diffStr .. zc.priceToMoneyString(a.diff)

			local rawStr = (a.rawUnit and a.rawUnit > 0) and zc.priceToMoneyString(a.rawTotal) or "|cff888888None|r"
			local barGrossStr = (a.craftedUnit and a.craftedUnit > 0) and zc.priceToMoneyString(a.craftedGross) or "|cff888888None|r"

			line.sub:SetText(string.format("Ore: %s | Bar: %s (Net: %s) | Diff: %s", rawStr, barGrossStr, zc.priceToMoneyString(a.craftedNet), diffStr))

			line:Show()
			yOffset = yOffset - 46
		end

	elseif currentTab == 3 then
		-- FLIPS & SNIPING TAB
		local deals, counts = Atr_GetFlipAnalysis(currentFlipFilter)

		local flipFilterDefs = {
			{ id = "ALL", label = "All Deals", count = counts.ALL },
			{ id = "BS", label = "Blacksmithing", count = counts.BS },
			{ id = "MATS", label = "Materials", count = counts.MATS },
			{ id = "BOE", label = "BoE Epics", count = counts.BOE },
			{ id = "RECIPES", label = "Recipes", count = counts.RECIPES },
			{ id = "SHORTAGES", label = "Shortages", count = counts.SHORTAGES },
		}

		-- Row 1: 3 buttons (width 116 each)
		local bIdx = 1
		local row1X = 0
		for r = 1, 3 do
			local def = flipFilterDefs[r]
			local btn = getglobal("Atr_PFlipBtn_" .. bIdx)
			if not btn then
				btn = CreateFrame("Button", "Atr_PFlipBtn_" .. bIdx, content, "UIPanelButtonTemplate")
				btn:SetHeight(20)
				btn:SetFrameLevel(content:GetFrameLevel() + 2)
			end
			btn:SetWidth(116)
			btn:ClearAllPoints()
			btn:SetPoint("TOPLEFT", row1X, yOffset)
			local btnTxt = string.format("%s (%d)", def.label, def.count or 0)
			if currentFlipFilter == def.id then
				btn:SetText("|cff00ff00[" .. btnTxt .. "]|r")
			else
				btn:SetText(btnTxt)
			end
			btn.filterId = def.id
			btn:SetScript("OnClick", function()
				currentFlipFilter = this.filterId
				Atr_RefreshProfitUI()
			end)
			btn:Show()
			row1X = row1X + 118
			bIdx = bIdx + 1
		end
		yOffset = yOffset - 22

		-- Row 2: 3 buttons (width 116 each)
		local row2X = 0
		for r = 4, 6 do
			local def = flipFilterDefs[r]
			local btn = getglobal("Atr_PFlipBtn_" .. bIdx)
			if not btn then
				btn = CreateFrame("Button", "Atr_PFlipBtn_" .. bIdx, content, "UIPanelButtonTemplate")
				btn:SetHeight(20)
				btn:SetFrameLevel(content:GetFrameLevel() + 2)
			end
			btn:SetWidth(116)
			btn:ClearAllPoints()
			btn:SetPoint("TOPLEFT", row2X, yOffset)
			local btnTxt = string.format("%s (%d)", def.label, def.count or 0)
			if currentFlipFilter == def.id then
				btn:SetText("|cff00ff00[" .. btnTxt .. "]|r")
			else
				btn:SetText(btnTxt)
			end
			btn.filterId = def.id
			btn:SetScript("OnClick", function()
				currentFlipFilter = this.filterId
				Atr_RefreshProfitUI()
			end)
			btn:Show()
			row2X = row2X + 118
			bIdx = bIdx + 1
		end
		yOffset = yOffset - 26

		if table.getn(deals) == 0 then
			if emptyText then
				emptyText:SetText("|cffffcc00No deals found in this category right now!|r\n\n1. Run '|cff00ffffFast AH Scan|r' or '|cff00ff00Full Scan...|r' on the AH to refresh all market prices.\n2. When players post items below market average, they will instantly appear here with 1-click buyout!\n\n|cff888888Tip: Check the 'All Deals' or 'Shortages' tab to see current opportunities.|r")
				emptyText:Show()
			end
		else
			for _, d in ipairs(deals) do
				local line = NextLine(350, 40)
				line:SetPoint("TOPLEFT", 0, yOffset)
				line.dealData = d
				line.searchTarget = d.name
				line:RegisterForClicks("LeftButtonUp", "RightButtonUp")

				if d.dealType == "SHORTAGE" then
					line.text:SetText(string.format("%s%s|r %s: |cffff44440 on AH|r", d.tagColor, d.tag, d.name))
					line.sub:SetText(string.format("Avg: %s  |cffffcc00Reset Opportunity!|r  |cff888888(Click: Search)|r", zc.priceToMoneyString(d.avgPrice)))
				else
					line.text:SetText(string.format("%s%s|r %s: %s", d.tagColor, d.tag, d.name, zc.priceToMoneyString(d.curPrice)))
					line.sub:SetText(string.format("Avg: %s  |cff00ff00Profit: +%s|r (-%d%%)  |cff888888(Click: Buy)|r", zc.priceToMoneyString(d.avgPrice), zc.priceToMoneyString(d.netProfit), d.discountPct))
				end

				line:SetScript("OnEnter", function()
					local data = this.dealData
					if not data then return end
					GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
					GameTooltip:SetText(data.name, 1, 1, 1)
					if data.dealType == "SHORTAGE" then
						GameTooltip:AddLine("Status: Market Shortage (Zero currently listed)", 1, 0.8, 0)
						GameTooltip:AddLine("Historical Market Avg: " .. zc.priceToMoneyString(data.avgPrice), 0.9, 0.9, 0.9)
						GameTooltip:AddLine("Opportunity: Post at high price or craft to fulfill demand!", 0, 1, 0)
					else
						GameTooltip:AddLine("Deal Rating: " .. data.tagColor .. data.tag, 1, 1, 1)
						GameTooltip:AddLine("Current Buyout: " .. zc.priceToMoneyString(data.curPrice), 1, 0.85, 0)
						GameTooltip:AddLine("Historical Market Avg: " .. zc.priceToMoneyString(data.avgPrice), 0.8, 0.8, 0.8)
						GameTooltip:AddLine(string.format("Discount: %d%% below market average", data.discountPct), 0, 1, 1)
						GameTooltip:AddLine("Estimated Net Resale Profit: " .. zc.priceToMoneyString(data.netProfit) .. " (after 5% AH fee)", 0, 1, 0)
					end
					GameTooltip:AddLine("Recorded Scans: " .. tostring(data.seenCount), 0.6, 0.6, 0.6)
					GameTooltip:AddLine(" ", 1, 1, 1)
					GameTooltip:AddLine("|cff00ff00Left-Click:|r Search & Buy immediately on AH", 0.9, 0.9, 0.9)
					GameTooltip:AddLine("|cffffaa00Right-Click:|r Add to Watchlist", 0.9, 0.9, 0.9)
					GameTooltip:Show()
				end)
				line:SetScript("OnLeave", function() GameTooltip:Hide() end)
				line:SetScript("OnClick", function()
					local tName = this.searchTarget
					if arg1 == "RightButton" then
						local exists = false
						for _, w in ipairs(AUCTIONATOR_WATCHLIST) do
							if w == tName then exists = true; break end
						end
						if not exists then
							table.insert(AUCTIONATOR_WATCHLIST, tName)
							if DEFAULT_CHAT_FRAME then
								DEFAULT_CHAT_FRAME:AddMessage(string.format("|cff00ff00[Auctionator Advisor]|r Added '|cffffffff%s|r' to Watchlist.", tName))
							end
						end
						return
					end
					Atr_SearchItemLive(tName)
				end)

				line:Show()
				yOffset = yOffset - 42
			end
		end

	elseif currentTab == 4 then
		-- DAILY MOVERS TAB (PRICE SURGES & DIPS)
		local rising, falling = Atr_GetDailyMovers()

		local mFilters = {
			{ id = "ALL", label = string.format("All Movers (%d)", table.getn(rising) + table.getn(falling)) },
			{ id = "RISING", label = string.format("[+] Rising (%d)", table.getn(rising)) },
			{ id = "FALLING", label = string.format("[-] Falling (%d)", table.getn(falling)) },
		}

		local mIdx = 1
		local mX = 0
		for _, mf in ipairs(mFilters) do
			local mBtn = getglobal("Atr_PMoverBtn_" .. mIdx)
			if not mBtn then
				mBtn = CreateFrame("Button", "Atr_PMoverBtn_" .. mIdx, content, "UIPanelButtonTemplate")
				mBtn:SetHeight(20)
				mBtn:SetFrameLevel(content:GetFrameLevel() + 2)
			end
			mBtn:SetWidth(116)
			mBtn:ClearAllPoints()
			mBtn:SetPoint("TOPLEFT", mX, yOffset)
			if currentMoverFilter == mf.id then
				mBtn:SetText("|cff00ff00[" .. mf.label .. "]|r")
			else
				mBtn:SetText(mf.label)
			end
			mBtn.filterId = mf.id
			mBtn:SetScript("OnClick", function()
				currentMoverFilter = this.filterId
				Atr_RefreshProfitUI()
			end)
			mBtn:Show()
			mX = mX + 118
			mIdx = mIdx + 1
		end
		yOffset = yOffset - 26

		if table.getn(rising) == 0 and table.getn(falling) == 0 then
			if emptyText then
				emptyText:SetText("|cffffcc00No significant price movements recorded yet today!|r\n\n1. Run '|cff00ffffFast AH Scan|r' or '|cff00ff00Full Scan...|r' periodically.\n2. As prices fluctuate throughout the day, commodities surging in price and items dropping into value territory will automatically appear here.")
				emptyText:Show()
			end
		else
			-- Section 1: Rising items
			if (currentMoverFilter == "ALL" or currentMoverFilter == "RISING") and table.getn(rising) > 0 then
				local h1 = NextLine(350, 22)
				h1:SetPoint("TOPLEFT", 0, yOffset)
				h1.text:SetText(string.format("|cff00ff00[+] TOP RISING COMMODITIES (%d)|r", table.getn(rising)))
				h1.sub:SetText("|cff888888Prices spiking above normal -- Great time to craft and sell!|r")
				h1:Show()
				yOffset = yOffset - 26

				local maxCount = (currentMoverFilter == "ALL") and 15 or table.getn(rising)
				for i = 1, math.min(maxCount, table.getn(rising)) do
					local r = rising[i]
					local line = NextLine(350, 38)
					line:SetPoint("TOPLEFT", 0, yOffset)
					line.moverData = r
					line.searchTarget = r.name
					line:RegisterForClicks("LeftButtonUp")

					line.text:SetText(string.format("|cff00ff00[+]|r %s: %s  |cff00ff00+%d%%|r", r.name, zc.priceToMoneyString(r.current), r.pct))
					line.sub:SetText(string.format("Avg: %s (Prev: %s)  |cff00ff00Sell Now!|r  |cff888888(Click: Search)|r", zc.priceToMoneyString(r.avg), zc.priceToMoneyString(r.prev)))

					line:SetScript("OnEnter", function()
						local d = this.moverData
						if not d then return end
						GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
						GameTooltip:SetText(d.name, 1, 1, 1)
						GameTooltip:AddLine("Trend: |cff00ff00Surging Price (+ " .. d.pct .. "%)|r", 1, 1, 1)
						GameTooltip:AddLine("Current Price: " .. zc.priceToMoneyString(d.current), 1, 0.85, 0)
						GameTooltip:AddLine("Previous Scan: " .. zc.priceToMoneyString(d.prev), 0.8, 0.8, 0.8)
						GameTooltip:AddLine("Historical Average: " .. zc.priceToMoneyString(d.avg), 0.8, 0.8, 0.8)
						GameTooltip:AddLine("Advice: Prices are elevated! High demand or supply shortage. Sell current stock or craft.", 0, 1, 0)
						GameTooltip:AddLine(" ", 1, 1, 1)
						GameTooltip:AddLine("|cff00ff00Left-Click:|r Search live on AH", 0.9, 0.9, 0.9)
						GameTooltip:Show()
					end)
					line:SetScript("OnLeave", function() GameTooltip:Hide() end)
					line:SetScript("OnClick", function()
						Atr_SearchItemLive(this.searchTarget)
					end)

					line:Show()
					yOffset = yOffset - 40
				end
				yOffset = yOffset - 8
			end

			-- Section 2: Falling items
			if (currentMoverFilter == "ALL" or currentMoverFilter == "FALLING") and table.getn(falling) > 0 then
				local h2 = NextLine(350, 22)
				h2:SetPoint("TOPLEFT", 0, yOffset)
				h2.text:SetText(string.format("|cffffaa00[-] TOP FALLING COMMODITIES (%d)|r", table.getn(falling)))
				h2.sub:SetText("|cff888888Prices dipped below average -- Buy low to flip or craft cheap!|r")
				h2:Show()
				yOffset = yOffset - 26

				local maxCount = (currentMoverFilter == "ALL") and 15 or table.getn(falling)
				for i = 1, math.min(maxCount, table.getn(falling)) do
					local f = falling[i]
					local line = NextLine(350, 38)
					line:SetPoint("TOPLEFT", 0, yOffset)
					line.moverData = f
					line.searchTarget = f.name
					line:RegisterForClicks("LeftButtonUp")

					line.text:SetText(string.format("|cffff4444[-]|r %s: %s  |cffff4444%d%%|r", f.name, zc.priceToMoneyString(f.current), f.pct))
					line.sub:SetText(string.format("Avg: %s (Prev: %s)  |cffffaa00Buy Dip!|r  |cff888888(Click: Search)|r", zc.priceToMoneyString(f.avg), zc.priceToMoneyString(f.prev)))

					line:SetScript("OnEnter", function()
						local d = this.moverData
						if not d then return end
						GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
						GameTooltip:SetText(d.name, 1, 1, 1)
						GameTooltip:AddLine("Trend: |cffff4444Price Dip (" .. d.pct .. "%)|r", 1, 1, 1)
						GameTooltip:AddLine("Current Price: " .. zc.priceToMoneyString(d.current), 1, 0.85, 0)
						GameTooltip:AddLine("Previous Scan: " .. zc.priceToMoneyString(d.prev), 0.8, 0.8, 0.8)
						GameTooltip:AddLine("Historical Average: " .. zc.priceToMoneyString(d.avg), 0.8, 0.8, 0.8)
						GameTooltip:AddLine("Advice: Undervalued! Great opportunity to buy cheap, hold, and flip when price rebounds.", 1, 0.8, 0)
						GameTooltip:AddLine(" ", 1, 1, 1)
						GameTooltip:AddLine("|cff00ff00Left-Click:|r Search live on AH", 0.9, 0.9, 0.9)
						GameTooltip:Show()
					end)
					line:SetScript("OnLeave", function() GameTooltip:Hide() end)
					line:SetScript("OnClick", function()
						Atr_SearchItemLive(this.searchTarget)
					end)

					line:Show()
					yOffset = yOffset - 40
				end
			end
		end

	elseif currentTab == 5 then
		-- FARMING & WATCHLIST TAB
		local farmFilters = {
			{ id = "FARM", label = "Farming Tips & Guides" },
			{ id = "WATCH", label = string.format("Watchlist (%d)", table.getn(AUCTIONATOR_WATCHLIST)) },
		}

		local fX = 0
		for fIdx, ff in ipairs(farmFilters) do
			local btn = getglobal("Atr_PFarmBtn_" .. fIdx)
			if not btn then
				btn = CreateFrame("Button", "Atr_PFarmBtn_" .. fIdx, content, "UIPanelButtonTemplate")
				btn:SetHeight(20)
				btn:SetFrameLevel(content:GetFrameLevel() + 2)
			end
			btn:SetWidth(174)
			btn:ClearAllPoints()
			btn:SetPoint("TOPLEFT", fX, yOffset)
			if currentFarmTab == ff.id then
				btn:SetText("|cff00ff00[" .. ff.label .. "]|r")
			else
				btn:SetText(ff.label)
			end
			btn.tabId = ff.id
			btn:SetScript("OnClick", function()
				currentFarmTab = this.tabId
				Atr_RefreshProfitUI()
			end)
			btn:Show()
			fX = fX + 178
		end
		yOffset = yOffset - 26

		if currentFarmTab == "FARM" then
			local tips = {
				"|cffffd100[1] Badlands Mining & Elementals (Lvl 35-40):|r\n  Mines: Rich Iron Ore, Mithril Ore (175+), Heavy & Solid Stone.\n  Mobs: Lesser Rock Elementals drop |cff00ff00Elemental Earth|r (1-3g each!).",
				"|cffffd100[2] Arathi Highlands Perimeter (Lvl 30-38):|r\n  Circle mountains for Iron Ore, Tin, Gold & Heavy Stone.\n  Burning Exile elementals drop |cff00ff00Elemental Fire|r (2-4g each!).",
				"|cffffd100[3] High-Demand Blacksmithing Crafts:|r\n  |cffffffffGolden Rod|r (1 Gold Bar, 2 Coarse Grinding Stone) - Needed by all Journeyman enchanters!\n  |cffffffffTruesilver Rod|r (1 Truesilver Bar, 1 Heavy Grinding Stone) - Needed by all Artisan enchanters!\n  |cffffffffSteel Weapon Chain|r - Disarm immunity for PvP.",
				"|cffffd100[4] Daily Consumable Sales:|r\n  Heavy & Solid Grinding Stones sell fast and consistently.\n  Iron & Mithril Bars sell at high volume for leveling crafters."
			}
			for _, txt in ipairs(tips) do
				local line = NextLine(345, 75)
				line:SetPoint("TOPLEFT", 0, yOffset)
				line:SetScript("OnClick", nil)
				line.text:SetText(txt)
				line.sub:SetText("")
				line:Show()
				yOffset = yOffset - 80
			end
		elseif currentFarmTab == "WATCH" then
			if table.getn(AUCTIONATOR_WATCHLIST) == 0 then
				if emptyText then
					emptyText:SetText("|cffffcc00Your Watchlist is empty!|r\n\nRight-click any recipe, flip candidate, or commodity in the advisor to add it to your Watchlist.")
					emptyText:Show()
				end
			else
				for _, itemName in ipairs(AUCTIONATOR_WATCHLIST) do
					local curPrice = Atr_GetMaterialCost(itemName)
					local hist = Atr_GetHistoricalData(itemName)
					local line = NextLine(350, 36)
					line:SetPoint("TOPLEFT", 0, yOffset)
					line.searchTarget = itemName
					line:RegisterForClicks("LeftButtonUp", "RightButtonUp")
					line:SetScript("OnEnter", function()
						GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
						GameTooltip:SetText(this.searchTarget, 1, 1, 1)
						GameTooltip:AddLine("|cff00ff00Left-Click:|r Search live AH", 0.8, 0.8, 0.8)
						GameTooltip:AddLine("|cffff4444Right-Click:|r Remove from Watchlist", 0.8, 0.8, 0.8)
						GameTooltip:Show()
					end)
					line:SetScript("OnLeave", function() GameTooltip:Hide() end)
					line:SetScript("OnClick", function()
						local tName = this.searchTarget
						if arg1 == "RightButton" then
							for idx, wName in ipairs(AUCTIONATOR_WATCHLIST) do
								if wName == tName then
									table.remove(AUCTIONATOR_WATCHLIST, idx)
									break
								end
							end
							if DEFAULT_CHAT_FRAME then
								DEFAULT_CHAT_FRAME:AddMessage(string.format("|cffffaa00[Auctionator Advisor]|r Removed '|cffffffff%s|r' from Watchlist.", tName))
							end
							GameTooltip:Hide()
							Atr_RefreshProfitUI()
							return
						end
						Atr_SearchItemLive(tName)
					end)

					local trendStr = "|cff888888(Stable)|r"
					if hist and hist.trend then
						if hist.trend > 0 then
							trendStr = string.format("|cff00ff00+ %d%%|r", hist.trendPct or 0)
						elseif hist.trend < 0 then
							trendStr = string.format("|cffff4444  %d%%|r", hist.trendPct or 0)
						end
					end

					line.text:SetText(string.format("%s: %s  %s", itemName, zc.priceToMoneyString(curPrice), trendStr))
					if hist and hist.avg then
						line.sub:SetText(string.format("Avg: %s  |  Min: %s  Max: %s  |cff888888(Click to check live)|r", zc.priceToMoneyString(hist.avg), zc.priceToMoneyString(hist.min), zc.priceToMoneyString(hist.max)))
					else
						line.sub:SetText("Run Fast Scan to collect price data  |cff00ffff(Click to check live)|r")
					end

					line:Show()
					yOffset = yOffset - 38
				end
			end
		end
	end

	Atr_UpdateScrollState(-yOffset + 60)
end

function Atr_ToggleProfitFrame(param)
	if param then
		param = string.lower(param)
		if param == "restore" or param == "unhide" or param == "reset" then
			Atr_RestoreIgnoredRecipes()
			return
		elseif param == "auto" then
			AUCTIONATOR_AUTO_OPEN_ADVISOR = not AUCTIONATOR_AUTO_OPEN_ADVISOR
			local state = AUCTIONATOR_AUTO_OPEN_ADVISOR and "|cff00ff00Enabled|r" or "|cffff4444Disabled|r"
			if DEFAULT_CHAT_FRAME then
				DEFAULT_CHAT_FRAME:AddMessage("|cff00ffff[Auctionator Advisor]|r Auto-open with Auction House: " .. state)
			end
			return
		end
	end

	local frame = Atr_CreateProfitFrame()
	if frame:IsShown() then
		frame:Hide()
	else
		frame:Show()
		Atr_RefreshProfitUI()
	end
end

----------------------------------------------------------------------
-- Auto-learn Events & Initialization
----------------------------------------------------------------------
local eventFrame = CreateFrame("Frame", "AtrProfitEvents")
eventFrame:RegisterEvent("TRADE_SKILL_SHOW")
eventFrame:RegisterEvent("TRADE_SKILL_UPDATE")
eventFrame:RegisterEvent("VARIABLES_LOADED")
eventFrame:RegisterEvent("AUCTION_HOUSE_SHOW")
eventFrame:RegisterEvent("AUCTION_HOUSE_CLOSED")
eventFrame:SetScript("OnEvent", function()
	if event == "VARIABLES_LOADED" then
		Atr_MigrateExistingScanDB()
	elseif event == "TRADE_SKILL_SHOW" or event == "TRADE_SKILL_UPDATE" then
		ScanOpenTradeSkill()
	elseif event == "AUCTION_HOUSE_SHOW" then
		Atr_MigrateExistingScanDB()
		Atr_EnsureAHProfitButton()
		if AUCTIONATOR_AUTO_OPEN_ADVISOR ~= false then
			local frame = Atr_CreateProfitFrame()
			if not frame.userMoved and AuctionFrame then
				frame:ClearAllPoints()
				frame:SetPoint("TOPLEFT", AuctionFrame, "TOPRIGHT", 10, -10)
			end
			if not frame:IsShown() then
				frame:Show()
				Atr_RefreshProfitUI()
			end
		end
	elseif event == "AUCTION_HOUSE_CLOSED" then
		if profitFrame and profitFrame:IsShown() then
			profitFrame:Hide()
		end
	end
end)
